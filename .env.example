# Database Configuration
DB_HOST=localhost
DB_NAME=journal_system
DB_USER=root
DB_PASS=your_password_here
DB_PORT=3306

# JWT Configuration
# Generate a long random value before running any authenticated endpoint.
# Example (PHP CLI): php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_ACCESS_EXPIRY=1800
JWT_REFRESH_EXPIRY=604800
