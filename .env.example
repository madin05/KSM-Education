# Database Configuration
DB_HOST=localhost
DB_NAME=journal_system2
DB_USER=root
DB_PASS=your_password_here
DB_PORT=3306

# Application / mail configuration
APP_ENV=production
APP_URL=http://localhost/ksmedu
MAIL_FROM=no-reply@example.test
# Localhost-only fallback. Keep this directory outside the web document root.
DEV_MAIL_DIR=C:/xampp/ksmedu-dev-mail

# JWT Configuration
# Generate a long random value before running any authenticated endpoint.
# Example (PHP CLI): php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_ACCESS_EXPIRY=1800
JWT_REFRESH_EXPIRY=604800

# Telegram token purchase bot
# Bot tokens are secrets. Create/rotate one with BotFather and never commit it.
TELEGRAM_BOT_TOKEN=replace_with_botfather_token
TELEGRAM_BOT_USERNAME=KSMedu_bot
# Numeric chat id of the private KSMedu Admin group, usually starts with -100.
TELEGRAM_ADMIN_CHAT_ID=
# Generate independently: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
TELEGRAM_WEBHOOK_SECRET=replace_with_random_webhook_secret
TELEGRAM_INTERNAL_SECRET=replace_with_random_internal_secret
# One-time code used by a group administrator: /setup <code>
TELEGRAM_ADMIN_SETUP_CODE=replace_with_random_admin_setup_code
# Format: token_count:price_rupiah separated by commas.
TELEGRAM_TOKEN_PACKAGES=5:10000,10:18000,20:34000,50:80000
# Keep payment instructions concise; \n is rendered as a line break in Telegram.
TELEGRAM_PAYMENT_INSTRUCTIONS=Transfer pembayaran sesuai paket ke rekening/QRIS KSM Education.\nCantumkan ID pesanan pada berita transfer.